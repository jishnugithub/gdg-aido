{
  "rules": {
    ".read": false,
    ".write": false,
    "locations": {
      "$jobId": {
        ".read": "auth != null",
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp'])"
        }
      }
    },
    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['isOnline', 'lastChanged'])"
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth != null",
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    }
  }
}
