rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return request.auth.token.admin == true; }
    function isJobParticipant(jobData) { return request.auth.uid == jobData.requesterId || request.auth.uid == jobData.aidmateId; }
    
    // Users - read by authenticated, write own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'phoneNumber', 'createdAt']);
      allow delete: if false;
    }
    
    // AidmateProfiles - read by authenticated, write own
    match /aidmateProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }
    
    // Jobs - complex rules
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.requesterId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offeredAmount', 'finalAmount', 'updatedAt', 'cancelledAt', 'cancellationReason'])) ||
        (resource.data.aidmateId == request.auth.uid)
      );
      allow delete: if false;
    }
    
    // JobOffers
    match /jobOffers/{offerId} {
      allow read: if isAuthenticated() && (resource.data.aidmateId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.requesterId == request.auth.uid);
      allow create: if false; // Only Cloud Functions create offers
      allow update: if isAuthenticated() && resource.data.aidmateId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }
    
    // Applications
    match /applications/{appId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.aidmateId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // Conversations - only participants
    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      // Messages subcollection
      match /messages/{msgId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if false;
      }
    }
    
    // Messages - only conversation participants
    match /messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // Payments - only participants + admin
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.requesterId == request.auth.uid || resource.data.aidmateId == request.auth.uid || isAdmin());
      allow create: if false; // Only Cloud Functions
      allow update: if false; // Only Cloud Functions
      allow delete: if false;
    }
    
    // Reviews - anyone authenticated can read, author can create
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    
    // Disputes - participants + admin
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (resource.data.raisedBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.raisedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
    
    // Notifications - own only
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false; // Only Cloud Functions
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }
    
    // AdminAuditLogs - admin only
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
      allow delete: if false;
    }
  }
}
