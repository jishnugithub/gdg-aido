# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=aidmate-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aidmate-app
VITE_FIREBASE_STORAGE_BUCKET=aidmate-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://aidmate-app-default-rtdb.firebaseio.com

# Firebase Emulators (set to 'true' to use local Firebase emulators)
VITE_USE_FIREBASE_EMULATOR=false

# Google Maps Platform API Key (Places, Maps, Geocoding, Directions)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Google Gemini API Key (Task assistant, smart categorization, description enhancer)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
